+
+/* Returns 1 if url is an SCP-style git remote ([user@]host:path) rather than
+ * a URL with a scheme (e.g. https://).  SCP-style addresses are not valid in
+ * HTML href attributes and must be rendered differently.
+ */
+extern int cgit_is_scp_url(const char *url);
--- cgit-1.3/shared.c	2026-02-24 01:44:41.000000000 +0000
+++ cgit-scp-only/shared.c	2026-04-28 05:55:32.634065766 +0000
@@ -581,3 +581,23 @@
 	fclose(file);
 	return NULL;
 }
+
+int cgit_is_scp_url(const char *url)
+{
+	const char *p;
+
+	if (!url || !*url)
+		return 0;
+	for (p = url; *p; p++) {
+		if (*p == '/')
+			return 0;
+		if (*p == ':') {
+			if (p[1] == '/')
+				return 0;
+			if (p == url)
+				return 0;
+			return 1;
+		}
+	}
+	return 0;
+}
