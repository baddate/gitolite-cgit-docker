--- cgit-1.3/shared.c	2026-02-24 01:44:41.000000000 +0000
+++ cgit-1.3-patched/shared.c	2026-04-27 16:18:30.743259953 +0000
@@ -581,3 +581,44 @@
 	fclose(file);
 	return NULL;
 }
+
+/*
+ * Detect SCP-style git remote URLs of the form:
+ *   [user@]host:path/to/repo.git
+ *
+ * These look like "something:something" without a "://" scheme separator.
+ * git(1) itself uses the same heuristic (see connect.c:is_scp_style_url).
+ *
+ * Rules:
+ *  - Must contain a ':' that is not preceded by '/' (rules out absolute
+ *    paths like /foo/bar) and not part of "://" (rules out http://, etc.).
+ *  - A Windows drive letter "C:" followed by '/' or '\\' is also excluded,
+ *    but that is irrelevant for a CGI running on Linux.
+ *
+ * Returns 1 for SCP-style, 0 otherwise.
+ */
+int cgit_is_scp_url(const char *url)
+{
+	const char *p;
+
+	if (!url || !*url)
+		return 0;
+
+	for (p = url; *p; p++) {
+		if (*p == '/') {
+			/* A '/' before any ':' means this is a local or
+			 * absolute path, not an SCP remote. */
+			return 0;
+		}
+		if (*p == ':') {
+			/* Exclude "://" (normal URL scheme). */
+			if (p[1] == '/')
+				return 0;
+			/* Must have something before the colon. */
+			if (p == url)
+				return 0;
+			return 1;
+		}
+	}
+	return 0;
+}
