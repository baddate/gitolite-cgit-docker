+/* Returns 1 if the url looks like an SCP-style git remote (user@host:path
+ * or host:path) rather than a regular URL with a scheme (e.g. https://).
+ * SCP-style URLs cannot be used as href values in HTML because they have no
+ * URL scheme, so callers must render them differently (e.g. as plain text).
+ */
+extern int cgit_is_scp_url(const char *url);
