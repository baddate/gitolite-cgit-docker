# ==============================================================================
# COMMON CONFIGURATION
# ==============================================================================

#
# Cache invalidation shared secret
# Must be the same in both gitolite and cgit containers.
# Generate with: openssl rand -hex 32
#
CGIT_INVALIDATE_SECRET=<YOUR-SECRET>

# ==============================================================================
# GITOLITE CONFIGURATION
# ==============================================================================

SSH_KEY=<YOUR-SSH-KEY>
SSH_KEY_NAME=admin

# ==============================================================================
# CGIT RUNTIME CONFIGURATION
# ==============================================================================

# --- IMPORTANT NOTES ---
# 1. NAMING CONVENTION: Variables must start with "CGIT_".
#    The script automatically converts them to cgitrc keys:
#    Format: Remove "CGIT_" -> Convert to lowercase -> Replace "_" with "-".
#    Example: CGIT_ENABLE_HTTP_CLONE  =>  enable-http-clone
#
# 2. VALUES:
#    - Use double quotes "" for values containing spaces (e.g., clone prefixes).
#    - Use 1 (true) or 0 (false) for boolean flags.
#
# 3. COMPATIBILITY:
#    - This script uses 'sed' to replace values in-place.
#    - Ensure the key already exists in your 'cgitrc.template' (e.g., root-title=).
# ------------------------------------------------------------------------------

# The title at the top of the main page
CGIT_ROOT_TITLE="Git Repository Browser"

# The description below the title
CGIT_ROOT_DESC="A fast web-interface for the git dscm"

# Clone URL prefixes (Space-separated)
# REQUIRED: Must be quoted if it contains multiple URLs
CGIT_CLONE_PREFIX="http://git.domain.com ssh://git@git.domain.com"

# Snapshot formats to provide (Space-separated)
CGIT_SNAPSHOTS="tar.gz tar.bz2 tar.xz"

# Enable/Disable HTTP cloning (1 to enable, 0 to disable)
CGIT_ENABLE_HTTP_CLONE=1

# --- Optional Extras ---
# CGIT_CSS="/custom.css"
# CGIT_LOGO="/logo.png"
# CGIT_PROJECT_LIST="projects.list"